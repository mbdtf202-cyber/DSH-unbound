{
  "name": "dsh-unbound",
  "version": "0.1.0",
  "description": "DeepSeek Harness unbound — type-safe host patching engine. TypeScript rewrite of dsh-qilin's patch layer with drift detection and a real test suite.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": "./client.js",
    "./engine": {
      "types": "./dist/engine/index.d.ts",
      "default": "./dist/engine/index.js"
    },
    "./patches": {
      "types": "./dist/patches/index.d.ts",
      "default": "./dist/patches/index.js"
    },
    "./service": {
      "types": "./dist/redteam/service.d.ts",
      "default": "./dist/redteam/service.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-unbound": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "patches",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:bundle && npm run build:client",
    "build:bundle": "tsc -p tsconfig.build.json && chmod +x dist/cli/index.js",
    "build:client": "node scripts/build-client.mjs",
    "check:client": "node scripts/build-client.mjs --check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build:test && node --test dist-test/test/*.test.js dist-test/test/*/*.test.js",
    "test:cov": "npm run build:test && node --test --experimental-test-coverage dist-test/test/*.test.js dist-test/test/*/*.test.js",
    "extract:patches": "node scripts/extract-patches.mjs",
    "verify:patches": "npm run build:test && node dist-test/scripts/verify-patches.js",
    "prepublishOnly": "npm run build && npm run check:client",
    "build:test": "tsc -p tsconfig.test.json",
    "prepare": "npm run build",
    "sync:patches": "node scripts/sync-patches.mjs sync",
    "verify:sync": "node scripts/sync-patches.mjs verify",
    "verify:tests": "npm run build:test && node dist-test/scripts/verify-test-coverage.js"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "patching",
    "typescript",
    "jailbreak",
    "llm-security",
    "prompt-eval"
  ],
  "engines": {
    "node": ">=22.15.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
